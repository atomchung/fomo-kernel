{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fomo-kernel.local/schemas/review-plan.schema.json",
  "title": "Fomo Kernel Review Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "status",
    "route",
    "flow_path",
    "language",
    "persist",
    "state_root",
    "input",
    "state_snapshot",
    "question_queue",
    "missing_thesis_positions",
    "card_plan",
    "engine_card",
    "engine_state"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "engine_version": {
      "type": "object",
      "required": [
        "id",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "enum": [
            "file",
            "git",
            "unknown"
          ]
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "status": {
      "const": "awaiting_answers"
    },
    "route": {
      "enum": [
        "first_review",
        "weekly_review",
        "snapshot_review",
        "test_drive"
      ]
    },
    "flow_path": {
      "type": "string"
    },
    "language": {
      "enum": [
        "zh-TW",
        "en"
      ]
    },
    "persist": {
      "type": "boolean"
    },
    "state_root": {
      "type": "string"
    },
    "input": {
      "type": "object",
      "required": [
        "paths",
        "kind",
        "fingerprint"
      ],
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kind": {
          "enum": [
            "trades_csv",
            "positions_snapshot"
          ]
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "engine_meta": {
          "type": "string"
        },
        "ledger_ingest": {
          "type": [
            "object",
            "null"
          ]
        },
        "price_feed": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "state_snapshot": {
      "type": "object"
    },
    "question_queue": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "required",
          "question",
          "options"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "add_thesis",
              "headline_motive",
              "revisit",
              "rule_breach",
              "due_revisit",
              "initial_thesis",
              "exit_consistency",
              "condition_crossing",
              "condition_basis"
            ]
          },
          "ticker": {
            "type": [
              "string",
              "null"
            ]
          },
          "cycle_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "value",
                "label",
                "description"
              ],
              "properties": {
                "value": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "prior_thesis_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "prior_event_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "decision_cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "asked_because": {
            "type": [
              "string",
              "null"
            ]
          },
          "question_opportunity": {
            "$ref": "question-opportunity.schema.json"
          },
          "revisit_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "exit_kind": {
            "enum": [
              "full",
              "reduce",
              null
            ]
          },
          "exit_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "exit_price": {
            "type": [
              "number",
              "null"
            ]
          },
          "shares_sold": {
            "type": [
              "number",
              "null"
            ]
          },
          "shares_before": {
            "type": [
              "number",
              "null"
            ]
          },
          "currency": {
            "type": [
              "string",
              "null"
            ]
          },
          "exit_notional": {
            "type": [
              "number",
              "null"
            ]
          },
          "cost_basis": {
            "type": [
              "number",
              "null"
            ]
          },
          "checkpoint": {
            "enum": [
              "30",
              "60",
              "90"
            ]
          },
          "due_date": {
            "type": "string"
          },
          "swaps": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "compare": {
            "type": [
              "object",
              "null"
            ]
          },
          "prior_exit_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "prior_note": {
            "type": [
              "string",
              "null"
            ]
          },
          "rule_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "rule_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "problem_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "breach_week": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "recent_count": {
            "type": "integer",
            "minimum": 0
          },
          "recent_amount": {
            "type": "number"
          },
          "trend": {
            "enum": [
              "better",
              "flat",
              "worse",
              null
            ]
          },
          "slot_id": {
            "type": "string",
            "description": "condition_crossing / condition_basis: the exact condition-slot row this question was posed against."
          },
          "line_id": {
            "type": "string",
            "description": "condition_crossing / condition_basis: the stable identity of that condition's line, which is what an answer and a revision are recorded against."
          },
          "condition_kind": {
            "enum": [
              "numeric",
              "event"
            ],
            "description": "condition_crossing: which answer vocabulary this question uses — confirmed/overridden for a numeric line the engine compared, yes/no for an occurrence only the user can settle."
          },
          "criterion": {
            "type": "string",
            "description": "condition_crossing / condition_basis: the user's own sentence, verbatim (#396). Never re-worded into the product's phrasing."
          },
          "evidence": {
            "type": "string",
            "description": "condition_crossing / condition_basis: what this period's lookup returned, with its source and as-of date. The engine's own rendering of the observation — never a verdict."
          },
          "basis_note": {
            "type": "string",
            "description": "condition_basis: why the agent believes the measurement basis changed underneath the frozen threshold."
          }
        },
        "additionalProperties": false
      }
    },
    "missing_thesis_positions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "authoring_contract": {
      "type": "object",
      "$comment": "Engine-derived authoring vocabulary (#251). The single source of truth is thesis.MATURITY_VALUES, thesis.INFERENCE_ENUMS, and card_renderer.ALLOWED_NARRATIVE; a contract test pins the equivalence. Optional so plans prepared before #251 stay readable."
    },
    "card_plan": {
      "type": "object",
      "properties": {
        "horizon_ids": {
          "type": "array",
          "items": {
            "enum": ["weeks", "quarters", "years"]
          },
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true
        },
        "question_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["route", "min", "max"],
          "properties": {
            "route": {"type": ["string", "null"]},
            "min": {"type": "integer", "minimum": 0},
            "max": {"type": "integer", "minimum": 0}
          }
        },
        "question_selection": {
          "type": "object",
          "$comment": "Plan-internal QA/agent-facing report of how the density band was filled (#291); never rendered on the card.",
          "additionalProperties": false,
          "required": ["route", "min", "max", "eligible", "selected", "shortfall_reason", "rejected"],
          "properties": {
            "route": {"type": ["string", "null"]},
            "min": {"type": "integer", "minimum": 0},
            "max": {"type": "integer", "minimum": 0},
            "eligible": {"type": "integer", "minimum": 0},
            "selected": {"type": "integer", "minimum": 0},
            "shortfall_reason": {
              "enum": [null, "insufficient_eligible_candidates"]
            },
            "rejected": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "kind", "cycle_id", "reason"],
                "properties": {
                  "id": {"type": ["string", "null"]},
                  "kind": {"type": ["string", "null"]},
                  "cycle_id": {
                    "type": ["string", "null"],
                    "$comment": "Stable join key present whenever a cycle is known (initial_thesis, add_thesis, cycle-bearing over_max rows); null for rule_breach or headline_motive."
                  },
                  "reason": {
                    "enum": [
                      "over_max_capacity",
                      "capture_limit",
                      "rule_breach_limit",
                      "initial_thesis_limit",
                      "already_captured",
                      "has_existing_thesis"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "evaluation_reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "summary"],
      "description": "Every still-open `review.py consider` evaluation (schemas/trade-evaluation.schema.json), reconciled against the transaction record as of this review's date_end (#317; #429's rule one layer up -- an evaluation nobody reconciles is the same dead-store shape #429 names for a question nobody reads). States a fact, never a cause: `status: matched` means a qualifying trade exists in the record, never that the user traded because of the evaluation, and nothing here ever writes `decision` -- schemas/trade-evaluation.schema.json's `decision` moves only through `consider --resolve`. A supply-side fact surface, not a card section or a question: issue #440 parks card layout, issue #453 leaves whether this earns a turn to the agent's per-scene judgment.",
      "properties": {
        "items": {
          "type": "array",
          "description": "Capped at review.py's EVALUATION_RECONCILE_CAP, oldest `created` first; `summary` states what a cap held back.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evaluation_id", "created", "premise", "status", "matched_trade"],
            "properties": {
              "evaluation_id": {"type": "string", "minLength": 1},
              "created": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "description": "The evaluation's own created date (schemas/trade-evaluation.schema.json's `created`), not this review's date_end."
              },
              "premise": {
                "$ref": "trade-premise.schema.json",
                "description": "The hypothetical trade this evaluation asked about, unchanged from when it was recorded."
              },
              "status": {
                "enum": ["matched", "unmatched"],
                "description": "matched: a trade of the same ticker and side exists in the record, dated on or after `created` and on or before this review's date_end. unmatched: no such trade was found. Never a claim about why a matched trade happened."
              },
              "matched_trade": {
                "type": ["object", "null"],
                "additionalProperties": false,
                "required": ["date", "qty"],
                "description": "The earliest qualifying trade, present only when status is matched; null otherwise.",
                "properties": {
                  "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
                  "qty": {"type": "number", "exclusiveMinimum": 0}
                }
              }
            }
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["open_total", "shown", "beyond_cap"],
          "description": "States the bound so `items` can never be mistaken for the complete list of open evaluations -- the same discipline card_plan.question_selection and state_snapshot.condition_slots_summary use for their own caps.",
          "properties": {
            "open_total": {"type": "integer", "minimum": 0},
            "shown": {"type": "integer", "minimum": 0},
            "beyond_cap": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "engine_card": {
      "type": "object"
    },
    "engine_state": {
      "type": "object"
    }
  }
}
