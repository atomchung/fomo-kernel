{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fomo-kernel.local/schemas/answers.schema.json",
  "title": "Fomo Kernel Review Answers",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "answers", "thesis_updates"],
  "properties": {
    "session_id": {"type": "string"},
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_id", "choice"],
        "properties": {
          "question_id": {"type": "string"},
          "choice": {"type": "string"},
          "note": {"type": ["string", "null"]},
          "response_mode": {
            "enum": ["canonical_choice", "own_words"]
          },
          "response_provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "user_statement",
              "motive_summary",
              "summary_author",
              "mapping_confidence",
              "unresolved",
              "interpretation_confirmed"
            ],
            "properties": {
              "user_statement": {"type": "string", "minLength": 1, "maxLength": 1200},
              "motive_summary": {"type": "string", "minLength": 1, "maxLength": 600},
              "summary_author": {"const": "ai_interpretation"},
              "mapping_confidence": {"enum": ["high", "medium", "low"]},
              "unresolved": {"type": "boolean"},
              "interpretation_confirmed": {"type": "boolean"},
              "clarification": {
                "type": "object",
                "additionalProperties": false,
                "required": ["stem", "grounding_refs", "user_statement"],
                "properties": {
                  "stem": {"type": "string", "minLength": 1, "maxLength": 1000},
                  "grounding_refs": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "context.ticker",
                        "context.prior_thesis.text",
                        "context.asked_because",
                        "context.headline_dimension.label",
                        "context.condition.criterion",
                        "context.condition.evidence",
                        "context.condition.basis_note"
                      ]
                    }
                  },
                  "user_statement": {"type": "string", "minLength": 1, "maxLength": 1200}
                }
              }
            }
          },
          "evidence_delta": {
            "type": ["object", "null"],
            "properties": {
              "claim": {"type": "string"},
              "source": {"type": "string"},
              "observed_at": {"type": ["string", "null"]},
              "falsifier": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          }
        }
      }
    },
    "commitment": {
      "type": "object",
      "required": ["choice"],
      "properties": {
        "choice": {"type": "string"},
        "rule": {"type": "string"},
        "metric_key": {"type": "string"},
        "goal": {"enum": ["down", "up", "hold"]},
        "dim": {"type": "string"},
        "revises_rule_id": {"type": "string"},
        "condition": {
          "$ref": "https://fomo-kernel.local/schemas/condition-slot.schema.json#/properties/input",
          "description": "#412: the user committed to something state.metrics cannot compute. Only with choice \"custom\", never together with metric_key, and never as a revise_rule replacement. The engine derives the tier, freezes the near-line margin, takes the baseline comparison and stores the slot in conditions.jsonl; `rule` must then be the criterion verbatim, or be omitted."
        }
      },
      "additionalProperties": false
    },
    "condition_checks": {
      "type": "array",
      "description": "#412: this review's result for each condition in review_plan.state_snapshot.condition_slots_due — one entry per condition, at most. Submitting the same envelope that was passed to `prepare --condition-checks` is what lets the engine record the reading the crossing question was actually posed against; a differing envelope fails closed. A due condition with no entry is recorded as not_checked rather than left as a gap in the file.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot_id", "check"],
        "properties": {
          "slot_id": {
            "type": "string",
            "description": "The condition this result is for. A slot_id held back by the plan's lookup cap is still accepted; an unknown one is an error."
          },
          "check": {
            "$ref": "https://fomo-kernel.local/schemas/condition-check.schema.json#/properties/input",
            "description": "The lookup envelope. `user_response` and `basis_resolution` are engine-supplied from the user's own answer to the condition question and must not be authored here."
          }
        }
      }
    },
    "condition_revision": {
      "type": ["object", "array"],
      "description": "#412: the re-stated criterion for a condition whose basis question was answered revise_threshold or revise_metric. Required by such an answer and refused without one. Never a rules revise_rule replacement — a condition line and a tracked rule are separate records, and a slot can never enter the mechanical rule reconciliation. Refused when the same line also answered a crossing this review (one change per line per session) or when of_line_id names no live condition.",
      "items": {"$ref": "#/$defs/condition_revision"},
      "properties": {
        "of_line_id": {"$ref": "#/$defs/condition_revision/properties/of_line_id"},
        "condition": {"$ref": "#/$defs/condition_revision/properties/condition"}
      },
      "additionalProperties": false
    },
    "thesis_updates": {"type": "array", "items": {"type": "object"}},
    "observations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "condition_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["of_line_id", "condition"],
      "properties": {
        "of_line_id": {
          "type": "string",
          "description": "The condition line being re-stated — the `line_id` the condition_basis question carried, not a slot_id."
        },
        "condition": {
          "$ref": "https://fomo-kernel.local/schemas/condition-slot.schema.json#/properties/input",
          "description": "The replacement criterion, in the user's own words. Stored as a new row on the same line with `revises` pointing at the row this review checked — never an edit to the old one."
        }
      }
    }
  }
}
