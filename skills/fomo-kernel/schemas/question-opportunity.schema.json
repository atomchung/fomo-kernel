{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fomo-kernel.local/schemas/question-opportunity.schema.json",
  "title": "Fomo Kernel Question Opportunity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "intent", "context", "answer_contract"],
  "properties": {
    "schema_version": {"const": 1},
    "intent": {
      "enum": ["classify_losing_position_add", "classify_headline_motive", "classify_initial_thesis", "classify_exit_consistency", "adjudicate_condition_crossing", "resolve_condition_basis"]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ticker": {"type": "string", "minLength": 1},
        "prior_thesis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "voice"],
          "properties": {
            "text": {"type": "string", "minLength": 1},
            "voice": {"enum": ["user_confirmed", "inferred"]}
          }
        },
        "asked_because": {"type": "string", "minLength": 1},
        "headline_dimension": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "label": {"type": "string", "minLength": 1}
          }
        },
        "condition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["criterion"],
          "description": "#412: the standing condition a condition_crossing or condition_basis question is about. No ticker and no dimension — a user-authored condition is not one of the engine's diagnostic axes, and grounding the stem in a position would invite it to argue about the position instead of the line.",
          "properties": {
            "criterion": {"type": "string", "minLength": 1, "description": "The user's own sentence, verbatim (#396)."},
            "evidence": {"type": "string", "minLength": 1, "description": "What this period's lookup returned, with its source and as-of date. The engine's own rendering of the observation — never a verdict."},
            "basis_note": {"type": "string", "minLength": 1, "description": "condition_basis only: why the measurement basis is believed to have changed."}
          }
        }
      }
    },
    "answer_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_choices",
        "requirements_by_choice",
        "requirement_text_by_choice",
        "allow_none_of_above",
        "max_clarifications"
      ],
      "properties": {
        "canonical_choices": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "requirements_by_choice": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "requirement_text_by_choice": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "allow_none_of_above": {"const": true},
        "max_clarifications": {"const": 1}
      }
    }
  }
}
