{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fomo-kernel.local/schemas/trigger-attempt-v2.schema.json",
  "title": "Fomo Kernel decision-lane trigger attempt (#827)",
  "description": "One append-only result row produced by evals/triggers/run_triggers.py for the current v2 corpus.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "corpus_version", "ts", "host", "host_version", "model",
    "installed_skill_population", "locale", "split", "prompt_id", "class",
    "expected_route", "actual_route", "raw_outcome"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "corpus_version": { "const": "v2" },
    "ts": {
      "type": "string",
      "description": "Informational UTC timestamp. File order is the fold authority."
    },
    "host": { "type": "string", "minLength": 1 },
    "host_version": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "installed_skill_population": {
      "type": "array",
      "items": { "type": "string" }
    },
    "locale": { "enum": ["en", "zh-TW", "zh-CN"] },
    "split": { "enum": ["calibration", "holdout"] },
    "prompt_id": {
      "type": "string",
      "minLength": 1,
      "description": "Resolved against corpus-v2/<locale>/<split>.json by the recorder."
    },
    "class": {
      "enum": ["named_security_decision", "candidate_discovery", "adjacent_negative"],
      "description": "Derived from prompt_id, never operator-supplied."
    },
    "expected_route": {
      "enum": ["trigger", "no_trigger"],
      "description": "Derived from the prompt class, never operator-supplied."
    },
    "actual_route": {
      "enum": ["trigger", "no_trigger"],
      "description": "The route the operator actually observed."
    },
    "raw_outcome": {
      "type": "string",
      "minLength": 1,
      "description": "Non-empty operator account of the observed host behavior."
    }
  }
}
